{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "flakeyard image repositories: default rules, released files are fix",
  "extends": ["/default"],
  "packageRules": [
    {
      "description": "Image contents (FY-0005, FY-0007)",
      "matchFileNames": ["flake.nix"],
      "semanticCommitType": "fix"
    }
  ]
}
